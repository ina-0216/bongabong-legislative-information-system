# iBOSys Mobile App - Environment Variables
# Copy this file to .env. The default points to the live iBOSys API.

# API Configuration
# Live Render API. For local backend development, replace with your LAN IP,
# Android emulator (http://10.0.2.2:5001/api), or iOS Simulator (localhost).
EXPO_PUBLIC_API_URL=https://ibosys-api.onrender.com/api

# Optional: Feature flags
# EXPO_PUBLIC_ENABLE_ANALYTICS=false
# EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
