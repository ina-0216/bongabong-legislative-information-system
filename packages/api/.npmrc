# Scoped to packages/api only.
#
# npm 11.3.0 arborist crashes with "Cannot read properties of null (reading
# 'edgesOut')" at #loadPeerSet while resolving vitest@4.1.11, because vitest
# 4.1.11 declares its @vitest/* optional peers at 5.0.3. packages/ui resolves
# the same version without crashing; this package consistently does not.
#
# Consequence of this setting: npm no longer auto-installs peerDependencies,
# so every non-optional peer is declared explicitly in package.json instead
# (vitest's mandatory peer `vite` is listed there for exactly this reason).
# CI reads this same file via `npm ci`, so installs stay reproducible.
legacy-peer-deps=true
