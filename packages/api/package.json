{
  "name": "@ibosys/api",
  "version": "0.1.0",
  "description": "Shared API client for iBOSys frontends",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "axios": "^1.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "jsdom": "^30.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}