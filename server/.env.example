PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ibosys
JWT_SECRET=change_me_to_a_strong_secret
UPLOAD_DIR=uploads/

# Email Configuration
# Production must use an HTTPS provider on Render Free (outbound SMTP is blocked).
# Resend requires a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public portal email verification codes are sent through Brevo.
# Create a Brevo account, verify the sender email address, and select this provider.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=

# Optional local-only Gmail SMTP fallback. Do not rely on SMTP on Render Free.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Required in production: deployed admin client origin, used for password reset links and CORS.
FRONTEND_URL=http://localhost:5173

# Required in production: deployed public portal origin for CORS.
PORTAL_URL=http://localhost:5174

# Optional comma-separated browser origins in addition to FRONTEND_URL and PORTAL_URL
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Required in production for consultation ID uploads and protected image delivery.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (for OTP storage and rate limiting)
REDIS_URL=redis://localhost:6379

# OTP delivery mode: textbee, philsms, or semaphore sends real SMS; test is development-only
SMS_OTP_MODE=textbee
# TextBee (requires a verified account, an online paired Android device with an active SIM, and an API key)
TEXTBEE_API_KEY=
# Optional: pin sends to a registered TextBee device instead of its default device
TEXTBEE_DEVICE_ID=
# Optional: change only when using a self-hosted TextBee API
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# PhilSMS (required when SMS_OTP_MODE=philsms)
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
# Semaphore (required only when SMS_OTP_MODE=semaphore)
SEMAPHORE_API_KEY=
# Optional: use a sender name registered and activated in Semaphore
SEMAPHORE_SENDERNAME=
